 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Faculty Report</title>\n\n    <style>\n        body{\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 13px;\n            color: #333;\n        }\n\n        .container{\n            width:100%;\n        }\n\n        h2{\n            text-align:center;\n            margin-bottom:5px;\n            color:#2c3e50;\n        }\n\n        .subtitle{\n            text-align:center;\n            color:#777;\n            margin-bottom:25px;\n            font-size:12px;\n        }\n\n        .section{\n            margin-top:20px;\n        }\n\n        .section-title{\n            background:#34495e;\n            color:#fff;\n            padding:8px 10px;\n            font-weight:bold;\n            font-size:14px;\n        }\n\n        table{\n            width:100%;\n            border-collapse:collapse;\n            margin-top:8px;\n        }\n\n        th, td{\n            border:1px solid #ccc;\n            padding:8px 10px;\n        }\n\n        th{\n            background:#f4f4f4;\n            text-align:left;\n        }\n\n        .label{\n            width:30%;\n            font-weight:bold;\n            background:#fafafa;\n        }\n\n        .footer{\n            margin-top:50px;\n            display:flex;\n            justify-content:space-between;\n        }\n\n        .sign{\n            width:220px;\n            text-align:center;\n        }\n\n        .sign hr{\n            border:0;\n            border-top:1px solid #555;\n            margin-bottom:6px;\n        }\n\n        @page{\n            size:A4;\n            margin:12mm;\n        }\n    </style>\n\n</head>\n<body>\n\n<div class=\"container\">\n\n    <h2>Faculty Report</h2>\n    <div class=\"subtitle\">\n        Apartment Maintenance Management System\n    </div>\n\n    <div class=\"section\">\n        <div class=\"section-title\">Faculty Information</div>\n\n        <table>\n            <tr>\n                <td class=\"label\">Faculty ID</td>\n                <td>{{ doc.faculty_id }}</td>\n            </tr>\n\n            <tr>\n                <td class=\"label\">Name</td>\n                <td>{{ doc.name1 }}</td>\n            </tr>\n\n            <tr>\n                <td class=\"label\">Email</td>\n                <td>{{ doc.email }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"section\">\n        <div class=\"section-title\">Assigned Tasks</div>\n\n        <table>\n\n            <thead>\n                <tr>\n                    <th style=\"width:8%;\">No.</th>\n                    <th>Resident</th>\n                    <th>Technician</th>\n                    <th>Problem ID</th>\n                    <th>Status</th>\n                </tr>\n            </thead>\n\n            <tbody>\n\n            {% for row in doc.task %}\n\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ row.resisdents }}</td>\n                    <td>{{ row.technicians }}</td>\n                    <td>{{ row.problem_id }}</td>\n                    <td>{{ row.status }}</td>\n                </tr>\n\n            {% endfor %}\n\n            </tbody>\n\n        </table>\n    </div>\n\n    <div class=\"footer\">\n\n        <div class=\"sign\">\n            <hr>\n            Faculty Signature\n        </div>\n\n        <div class=\"sign\">\n            <hr>\n            Authorized Signature\n        </div>\n\n    </div>\n\n</div>\n\n</body>\n</html>",
