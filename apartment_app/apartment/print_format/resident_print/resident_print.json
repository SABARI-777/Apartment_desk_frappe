 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Resident Complaint Report</title>\n\n<style>\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n    font-family:Arial, Helvetica, sans-serif;\n}\n\nbody{\n    font-size:13px;\n}\n\n.report{\n    width:100%;\n    padding:15px;\n}\n\nh1{\n    text-align:center;\n    margin-bottom:5px;\n    color:#222;\n}\n\n.subtitle{\n    text-align:center;\n    color:#666;\n    margin-bottom:20px;\n}\n\n.section-title{\n    background:#1565c0;\n    color:#fff;\n    padding:8px 12px;\n    margin-top:20px;\n    font-weight:bold;\n}\n\ntable{\n    width:100%;\n    border-collapse:collapse;\n}\n\n.info-table td{\n    border:1px solid #000;\n    padding:8px;\n}\n\n.info-table td.label{\n    width:30%;\n    font-weight:bold;\n    background:#f2f2f2;\n}\n\n.child-table{\n    margin-top:10px;\n}\n\n.child-table th,\n.child-table td{\n    border:1px solid #000;\n    padding:8px;\n    text-align:center;\n}\n\n.child-table th{\n    background:#1565c0;\n    color:#fff;\n}\n\n.footer{\n    margin-top:40px;\n    display:flex;\n    justify-content:space-between;\n}\n\n.signature{\n    width:220px;\n    text-align:center;\n}\n\n.signature hr{\n    margin-bottom:5px;\n}\n\n@media print{\n    @page{\n        size:A4;\n        margin:10mm;\n    }\n}\n</style>\n\n</head>\n\n<body>\n\n<div class=\"report\">\n\n<h1>Resident Complaint Report</h1>\n<p class=\"subtitle\">\nApartment Maintenance Management System\n</p>\n\n<div class=\"section-title\">\nResident Details\n</div>\n\n<table class=\"info-table\">\n\n<tr>\n    <td class=\"label\">User Name</td>\n    <td>{{ doc.user_name }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Mobile Number</td>\n    <td>{{ doc.moble_number }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Email</td>\n    <td>{{ doc.email }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Apartment Name</td>\n    <td>{{ doc.apartment_name }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Resident Number</td>\n    <td>{{ doc.resident_number }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Block</td>\n    <td>{{ doc.block }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Resident ID</td>\n    <td>{{ doc.resident_id }}</td>\n</tr>\n\n</table>\n\n<div class=\"section-title\">\nComplaint Details\n</div>\n\n<table class=\"child-table\">\n\n<thead>\n<tr>\n    <th>S.No</th>\n    <th>Problem ID</th>\n    <th>Problem</th>\n    <th>Category</th>\n    <th>Complaint Date</th>\n    <th>Due Date</th>\n    <th>Completed Date</th>\n    <th>Status</th>\n</tr>\n</thead>\n\n<tbody>\n\n{% for row in doc.problems %}\n\n<tr>\n    <td>{{ loop.index }}</td>\n    <td>{{ row.problem_id }}</td>\n    <td>{{ row.problem }}</td>\n    <td>{{ row.category }}</td>\n    <td>{{ frappe.utils.format_datetime(row.date_time) if row.date_time else \"\" }}</td>\n    <td>{{ frappe.utils.format_date(row.due_time) if row.due_time else \"\" }}</td>\n    <td>{{ frappe.utils.format_datetime(row.completed_date) if row.completed_date else \"\" }}</td>\n    <td>{{ row.status }}</td>\n</tr>\n\n{% endfor %}\n\n</tbody>\n\n</table>\n\n<div class=\"footer\">\n\n<div class=\"signature\">\n<hr>\nResident Signature\n</div>\n\n<div class=\"signature\">\n<hr>\nAuthorized Signature\n</div>\n\n</div>\n\n</div>\n\n</body>\n</html>",
