 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Technician Report</title>\n\n   <style>\n    @page {\n        size: A4;\n        margin: 15mm;\n    }\n\n    body {\n        font-family: \"Segoe UI\", Arial, sans-serif;\n        font-size: 13px;\n        color: #333;\n        line-height: 1.5;\n    }\n\n    h2 {\n        text-align: center;\n        font-size: 22px;\n        margin: 0;\n        color: #1f2937;\n    }\n\n    .subtitle {\n        text-align: center;\n        font-size: 13px;\n        color: #6b7280;\n        margin: 6px 0 24px;\n    }\n\n    .section-title {\n        background: #2c3e50;\n        color: #fff;\n        padding: 8px 12px;\n        font-size: 14px;\n        font-weight: 600;\n        border-radius: 4px;\n        margin: 20px 0 10px;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 18px;\n    }\n\n    th,\n    td {\n        border: 1px solid #d1d5db;\n        padding: 10px;\n        vertical-align: top;\n    }\n\n    th {\n        background: #f3f4f6;\n        color: #1f2937;\n        font-weight: 600;\n        text-align: left;\n    }\n\n    .label {\n        width: 30%;\n        background: #f9fafb;\n        font-weight: 600;\n        color: #374151;\n    }\n\n    .footer {\n        margin-top: 50px;\n        display: flex;\n        justify-content: space-between;\n    }\n\n    .signature {\n        width: 220px;\n        text-align: center;\n        color: #374151;\n    }\n\n    .signature hr {\n        border: none;\n        border-top: 1px solid #666;\n        margin-bottom: 6px;\n    }\n</style>\n</head>\n<body>\n\n<h2>Technician Report</h2>\n<p class=\"subtitle\">Apartment Maintenance Management System</p>\n\n<div class=\"section-title\">\nTechnician Details\n</div>\n\n<table>\n\n<tr>\n    <td class=\"label\">Technician ID</td>\n    <td>{{ doc.technician_id }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Name</td>\n    <td>{{ doc.name1 }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Email</td>\n    <td>{{ doc.email }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Category</td>\n    <td>{{ doc.category }}</td>\n</tr>\n\n<tr>\n    <td class=\"label\">Phone</td>\n    <td>{{ doc.phone }}</td>\n</tr>\n\n</table>\n\n<div class=\"section-title\">\nAssigned Tasks\n</div>\n\n<table>\n\n<thead>\n\n<tr>\n    <th>S.No</th>\n    <th>Resident</th>\n    <th>Problem ID</th>\n    <th>Date</th>\n    <th>Status</th>\n</tr>\n\n</thead>\n\n<tbody>\n\n{% for row in doc.tasks %}\n\n<tr>\n    <td>{{ loop.index }}</td>\n    <td>{{ row.resident }}</td>\n    <td>{{ row.problem_id }}</td>\n    <td>{{ frappe.utils.format_date(row.date) if row.date else \"\" }}</td>\n    <td>{{ row.status }}</td>\n</tr>\n\n{% endfor %}\n\n</tbody>\n\n</table>\n\n<div class=\"footer\">\n\n<div class=\"signature\">\n<hr>\nTechnician Signature\n</div>\n\n<div class=\"signature\">\n<hr>\nAuthorized Signature\n</div>\n\n</div>\n\n</body>\n</html>",
